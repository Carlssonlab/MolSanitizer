  </ring>
  <ring name="cyclohexa-1,3-diene-like">
    <note note=""/>
    <smarts smarts="[*^2]1~[*^2]-[*^2]~[*^2]-A-A-1"/>
    <ref ref="https://doi.org/10.1016/0022-2860(81)85056-9"/>
    <dihedral_sets>
      <set dihedral="'10', '0', '-20', '35', '-35', '0'" value="1"/>
      <set dihedral="'-10', '0', '20', '-35', '35', '0'" value="2"/>
    </dihedral_sets>
  </ring>

  <ring name="thioxanthene-like">
    <note note="Could be regarded as cyclohexa-1-4-diene with the two double bonds being aromatic bonds. Boat-like"/>
    <smarts smarts="*1:*-[A^3]-*:*-[A^3]-1"/>
    <ref ref="https://doi.org/10.1107/S056774086900598X"/>
    <dihedral_sets>
      <set dihedral="'-30', '30', '0', '-30', '30', '0'" value="1"/>
      <set dihedral="'30', '-30', '0', '30', '-30', '0'" value="2"/>
    </dihedral_sets>
  </ring>

  <ring name="sulfamide/sulfate - 6 member">
    <note note="Prefer chair, just like cyclohexane"/>
    <smarts smarts="[S;$(S(=O)(=O))]1-[N,O]-[A^3]-[A^3]-[A^3]-[N,O]-1"/>
    <ref ref=""/>
    <dihedral_sets>
      <set dihedral="'60', '-60', '60', '-60', '60', '-60'" value="1"/>
      <set dihedral="'-60', '60', '-60', '60', '-60', '60'" value="2"/>
    </dihedral_sets>
  </ring>
  
  <ring name="imide - 6 member">
    <note note="(C=O)-(N)-(C=O), busperidone"/>
    <smarts smarts="[C;$(C=[O,SX1])]1-[N,O]-[C;$(C=[O,SX1])]-[A^3]-[A^3]-[A^3]-1"/>
    <ref ref="https://doi.org/10.1021/ja00453a059"/>
    <dihedral_sets>
      <set dihedral="'0', '-30', '60', '-60', '30', '0'" value="1"/>
      <set dihedral="'0', '30', '-60', '60', '-30', '0'" value="2"/>
    </dihedral_sets>
  </ring>

  <ring name="carbamide/carbonate - 6 member">
    <note note="(N/O)-(C=O)-(N/O), check HIV Pro Inh- ter. ureas"/>
    <smarts smarts="[C;$(C=O)]1-[N,O]-[A^3]-[A^3]-[A^3]-[N,O]-1"/>
    <ref ref=""/>
    <dihedral_sets>
      <set dihedral="'-30', '60', '-60', '30', '0', '0'" value="1"/>
      <set dihedral="'30', '-60', '60', '-30', '0', '0'" value="2"/>
    </dihedral_sets>
  </ring>
  
  <ring name="cyclohexene-like">
    <note note="lactam/lactone"/>
    <smarts smarts="[C;$(C=[O,SX1])]1-[N,O]-[A^3]-[A^3]-[A^3]-[A^3]-1"/>
    <ref ref=""/>
    <dihedral_sets>
      <set dihedral="'15', '-30', '45', '-60', '45', '-30'" value="1"/>
      <set dihedral="'-15', '30', '-45', '60', '-45', '30'" value="2"/>
    </dihedral_sets>
  </ring>

  <!-- Still lacks cyclohexene+sp2-1,2,3 and cyclohexene+sp2-1,2,4-->
  <ring name="cyclohexene_sp2-1,2,4_">
    <smarts smarts="*1=,:*-[A^3]-[*^2]-[A^3]-[A^3]-1"/>
    <ref ref=""/>
    <dihedral_sets>
      <set dihedral="'-15', '45', '-60', '45', '-15', '0'" value="1"/>
      <set dihedral="'15', '-45', '60', '-45', '15', '0'" value="2"/>
      <set dihedral="'0', '-30', '60', '-60', '30', '0'" value="3"/>
      <set dihedral="'0', '30', '-60', '60', '-30', '0'" value="4"/>
      <set dihedral="'-45', '45', '0', '-45', '45', '0'" value="5"/> <!-- boat form -->
      <set dihedral="'45', '-45', '0', '45', '-45', '0'" value="6"/> <!-- boat form -->
    </dihedral_sets>
  </ring> 

<ring name="cyclohexene_sp2-1,2,3_">
    <smarts smarts="*1=,:*-[*^2]-[A^3]-[A^3]-[A^3]-1"/>
    <ref ref=""/>
    <dihedral_sets>
      <set dihedral="'0', '-30', '60', '-45', '20', '0'" value="1"/> <!--CCDC CUPVAO CUPTUG JOBDIQ-->
      <set dihedral="'0', '30', '-60', '45', '-20', '0'" value="2"/> <!--CCDC JOBCOV-->
      <set dihedral="'30', '-60', '60', '-30', '0', '0'" value="3"/> <!--CCDC AMAJED BOXMAG FAFDUO-->
      <set dihedral="'-30', '60', '-60', '30', '0', '0'" value="4"/> 
    </dihedral_sets>
  </ring> 
  <ring name="cyclohexene">
    <note note=""/>
    <smarts smarts="*1=,:*-[A^3]-[A^3]-[A^3]-[A^3]-1"/>
    <ref ref="https://doi.org/10.1016/0022-2860(68)87035-8"/>
    <dihedral_sets>
      <set dihedral="'-15', '45', '-60', '45', '-15', '0'" value="1"/>
