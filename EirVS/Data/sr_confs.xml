  </ring>
  <ring name="cycloheptatriene">
    <note note="prefered boat form, not planar"/>
    <smarts smarts="*1=,:*-*=,:*-*=,:*-A-1"/>
    <ref ref="https://doi.org/10.1016/0166-1280(82)80039-0"/>
    <dihedral_sets>
      <set dihedral="'30', '0', '-30', '0', '45', '-45', '0'" value="1"/>
