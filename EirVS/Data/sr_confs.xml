<!-- SmallRing Conformation Library v1.0
Curated from literature and small molecule crystal structures from CSD and PDB
Update upto 8-membered rings (cyclooctane)

Authors: Thua-Phong Lam, Szymon Pach.
Place: Jens Carlsson's Lab, Uppsala University, Sweden.
Date: 2024-09-14
-->

<library>
  <ring name="planar-aro-5-member">
    <smarts smarts="a1aaaa1"/>
    <dihedral_sets>
      <set dihedral="'0', '0', '0', '0', '0'" value="1"/>
    </dihedral_sets>
  </ring>
  <ring name="planar-aro-6-member">
    <smarts smarts="a1aaaaa1"/>
    <dihedral_sets>
      <set dihedral="'0', '0', '0', '0', '0', '0'" value="1"/>
    </dihedral_sets>
  </ring>
  <ring name="planar-aro-7-member">
    <smarts smarts="a1aaaaaa1"/>
    <dihedral_sets>
      <set dihedral="'0', '0', '0', '0', '0', '0', '0'" value="1"/>
    </dihedral_sets>
  </ring>
  <ring name="planar-4-member">
    <smarts smarts="*1~[*^2]~[*^2]~*~1"/>
    <dihedral_sets>
      <set dihedral="'0', '0', '0', '0'" value="1"/>
    </dihedral_sets>
  </ring>
  <ring name="planar-5-member1">
    <smarts smarts="*1~[A^2;!$(O(a)[A^3])]~[*^2]~[*^2]~*1"/>
    <dihedral_sets>
      <set dihedral="'0', '0', '0', '0', '0'" value="1"/>
    </dihedral_sets>
  </ring>
  <ring name="planar-5-member2">
    <smarts smarts="[A^2;!$(O(a)[A^3])]1~*~[*^2]~[*^2]~*1"/>
    <dihedral_sets>
      <set dihedral="'0', '0', '0', '0', '0'" value="1"/>
    </dihedral_sets>
  </ring>
  <ring name="planar-6-member">
    <smarts smarts="*1~[A^2;!$(O(a)[A^3])]~[*^2]~[*^2]~[*^2]~[*^2]~1"/>
    <dihedral_sets>
      <set dihedral="'0', '0', '0', '0', '0', '0'" value="1"/>
    </dihedral_sets>
  </ring>
  <ring name="planar-cyclohexa-1,4-dien">
    <smarts smarts="*1=,:*-A-*=*-A-1"/>
    <dihedral_sets>
      <set dihedral="'0', '0', '0', '0', '0', '0'" value="1"/>
    </dihedral_sets>
  </ring>
  <ring name="cyclobutane">
    <note note=""/>
    <smarts smarts="[A^3]1-[A^3]-[A^3]-[A^3]-1"/>
    <ref ref=""/>
    <dihedral_sets>
      <set dihedral="'20', '-20', '20', '-20'" value="1"/>
      <set dihedral="'-20', '20', '-20', '20'" value="2"/>
    </dihedral_sets>
  </ring>
  <ring name="5-membered lactam/lactone">
    <note note=""/>
    <smarts smarts="[C;$(C=[O,SX1])]1-[N,O]-[A^3]-[A^3]-[A^3]-1"/>
    <ref ref=""/>
    <dihedral_sets>
      <set dihedral="'-20', '20', '-20', '20', '0'" value="1"/>
      <set dihedral="'20', '-20', '20', '-20', '0'" value="2"/>
    </dihedral_sets>
  </ring>
  <ring name="cyclopentene">
    <note note=""/>
    <smarts smarts="*1=,:*-[A^3]-[A^3]-[A^3]-1"/>
    <ref ref="https://doi.org/10.1016/0166-1280(83)80021-9"/>
    <dihedral_sets>
      <set dihedral="'-20', '20', '-20', '20', '0'" value="1"/>
      <set dihedral="'20', '-20', '20', '-20', '0'" value="2"/>
    </dihedral_sets>
  </ring>
  <ring name="cyclopentane">
    <note note=""/>
    <smarts smarts="[A^3]1-[A^3]-[A^3]-[A^3]-[A^3]-1"/>
    <ref ref="https://doi.org/10.1016/0166-1280(83)80021-9"/>
    <dihedral_sets>
      <set dihedral="'0', '-25', '40', '-40', '25'" value="1"/>
      <set dihedral="'-25', '40', '-40', '25', '0'" value="2"/>
      <set dihedral="'40', '-40', '25', '0', '-25'" value="3"/>
      <set dihedral="'-40', '25', '0', '-25', '40'" value="4"/>
      <set dihedral="'25', '0', '-25', '40', '-40'" value="5"/>
      <set dihedral="'0', '25', '-40', '40', '-25'" value="6"/>
      <set dihedral="'25', '-40', '40', '-25', '0'" value="7"/>
      <set dihedral="'-40', '40', '-25', '0', '25'" value="8"/>
      <set dihedral="'40', '-25', '0', '25', '-40'" value="9"/>
      <set dihedral="'-25', '0', '25', '-40', '40'" value="10"/>
